{
  "name": "e-book-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Secure digital book distribution platform: marketing site, admin dashboard, API and private PWA reader.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "setup": "node scripts/setup-dev.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "seed:dev": "node --env-file-if-exists=.env scripts/seed-dev.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "audit": "npm audit --omit=dev"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "domutils": "^4.0.2",
    "express": "^5.3.0",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.1"
  },
  "optionalDependencies": {
    "@aws-sdk/client-kms": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0"
  }
}
