# Copy to .env and fill in. Never commit the real file.
# Values marked REQUIRED must be set; the server refuses to start without them.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Number of reverse proxies in front of the app (for correct client IPs and HTTPS detection).
TRUST_PROXY=1
# Cookies are sent only over HTTPS. Must be true in production.
COOKIE_SECURE=true
LOG_LEVEL=info
# Run database migrations automatically at startup (otherwise run `npm run migrate`).
MIGRATE_ON_START=false

# --- Database (REQUIRED) -----------------------------------------------------
DATABASE_URL=postgres://bookapp:CHANGE_ME@db.internal:5432/bookapp
# Use TLS to the database (recommended for managed databases).
DATABASE_SSL=true

# --- Domains -----------------------------------------------------------------
# Public marketing website.
PUBLIC_BASE_URL=https://example.com
# Management dashboard. If it differs from PUBLIC_BASE_URL, /admin is served only on this host.
ADMIN_BASE_URL=https://admin.example.com
# Private reader PWA. Invitation links use this domain. If it differs from PUBLIC_BASE_URL,
# reader pages and customer APIs are served only on this host.
READER_BASE_URL=https://reader.example.com
# Optional extra ports so one server can host each app on its own port (development or a single
# machine). Which app answers on which port follows the *_BASE_URL values above.
# Example: PORT=3000 READER_PORT=3000 PUBLIC_PORT=3001 ADMIN_PORT=3002
READER_PORT=
PUBLIC_PORT=
ADMIN_PORT=
# Country calling code used when a customer types a local number (e.g. 0712 345 678).
DEFAULT_COUNTRY_CODE=254

# --- Secrets (REQUIRED) ------------------------------------------------------
# Server-side pepper for hashing invitation tokens, session tokens, OTP codes and IPs.
# At least 32 random characters:  openssl rand -base64 48
HASH_PEPPER=

# --- Key management ----------------------------------------------------------
# aws   = AWS KMS envelope encryption (recommended for production)
# local = key-encryption key from LOCAL_MASTER_KEY (small deployments; keep it in a secret manager)
KMS_PROVIDER=aws
AWS_REGION=eu-west-1
AWS_KMS_KEY_ID=arn:aws:kms:eu-west-1:123456789012:key/00000000-0000-0000-0000-000000000000
# Only for KMS_PROVIDER=local: 64 hex characters.  openssl rand -hex 32
LOCAL_MASTER_KEY=

# --- Private object storage --------------------------------------------------
# s3    = private S3 (or S3-compatible) bucket with Block Public Access enabled
# local = directory on disk outside the web root
STORAGE_DRIVER=s3
S3_BUCKET=my-private-book-bucket
# For S3-compatible providers (Cloudflare R2, MinIO, Wasabi...). Leave empty for AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Only for STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/var/lib/bookapp/storage
# AWS credentials come from the standard provider chain (instance role, AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, AWS_PROFILE...).

# --- Uploads -----------------------------------------------------------------
MAX_BOOK_UPLOAD_MB=100
MAX_COVER_UPLOAD_MB=5
# ClamAV daemon (clamd) for malware scanning of uploads.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Refuse uploads when no scanner is configured.
REQUIRE_MALWARE_SCAN=false
# Poppler's pdftoppm renders PDF editions to page images.
PDFTOPPM_PATH=pdftoppm
PDF_RENDER_DPI=110

# --- OTP delivery (WhatsApp Business Cloud API) ------------------------------
# whatsapp_cloud in production. "console" prints codes to the log and is refused in production.
OTP_PROVIDER=whatsapp_cloud
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Name of your approved AUTHENTICATION template (one body parameter + copy-code button).
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en

# --- Administrators ----------------------------------------------------------
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_MINUTES=60
# Force every administrator to set up two-factor authentication before using the dashboard.
REQUIRE_ADMIN_MFA=true
